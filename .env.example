# Local development settings. `make up` copies this to `.env` (git-ignored) on first run.
# These are throwaway credentials for containers on your machine, not secrets;
# change them in `.env` if you like. Never commit `.env`.

POSTGRES_USER=control_plane
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=control_plane

RABBITMQ_USER=control_plane
RABBITMQ_PASSWORD=local-dev-only

# Host ports
API_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672

LOG_LEVEL=INFO

# Worker simulator defaults (CLI flags override these)
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2000
WORKER_DUPLICATE_RATE=0
WORKER_OUT_OF_ORDER_RATE=0
